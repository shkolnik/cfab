                      ]
                    }
                  }
                ]
              }
            },
            "neighbors": {
              "neighbor": [
                {
                  "remote-address": "192.168.249.254",
                  "peer-as": 65000,
                  "timers": {
                    "connect-retry-interval": 3,
                    "hold-time": 3,
                    "keepalive": 1
                  },
                  "transport": {
                    "local-address": "192.168.249.2"
                  },
                  "afi-safis": {
                    "afi-safi": [
                      {
                        "name": "iana-bgp-types:ipv4-unicast",
