  "ietf-routing-policy:routing-policy": {
    "defined-sets": {
      "prefix-sets": {
        "prefix-set": [
          {
            "name": "cfab-mgmt-id",
            "mode": "ipv4",
            "prefixes": {
              "prefix-list": [
                {
                  "ip-prefix": "10.249.0.0/24",
                  "mask-length-lower": 32,
                  "mask-length-upper": 32
                }
              ]
            }
          }
        ]
      }
    },
    "policy-definitions": {
      "policy-definition": [
        {
          "name": "cfab-mgmt-import",
          "statements": {
            "statement": [
              {
                "name": "1",
                "conditions": {
                  "match-prefix-set": {
                    "prefix-set": "cfab-mgmt-id"
                  }
                },
                "actions": {
                  "policy-result": "accept-route",
                  "ietf-bgp-policy:bgp-actions": {
                    "set-med": "igp"
                  }
                }
              }
            ]
          }
        },
        {
          "name": "cfab-mgmt-export",
          "statements": {
            "statement": [
              {
                "name": "1",
                "conditions": {
                  "match-prefix-set": {
                    "prefix-set": "cfab-mgmt-id"
                  }
                },
                "actions": {
                  "policy-result": "accept-route",
                  "ietf-bgp-policy:bgp-actions": {
                    "set-next-hop": "self"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
