[Unit]
Description=cfab fabric member
Documentation=man:cfab(8)
# The wires must exist and be named before the apply configures them; ifupdown2/PVE boot
# ordering beyond this is unverified, and no ordering against frr.service is declared.
After=network-online.target networking.service
Wants=network-online.target
# Installed but unconfigured is a clean boot, not a failure: with no declaration there is
# nothing to apply, so the unit is skipped rather than started and failed.
ConditionPathExists=/etc/cfab/fabric.toml
# Never give up on a member whose absence is "no fabric" on an unattended host. Measured
# 2026-09-05 on pve1-tb: the default 5-starts-in-10-s limit turned a crash loop into a
# permanent silent outage.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/cfab run
# Reload re-reads /etc/cfab/fabric.toml. Unchanged declaration = re-apply in place: no
# teardown, no netdev churn, the engine and the shape daemon restart. Changed declaration =
# teardown + exit 6, and the restart below applies it (an in-place apply cannot: it creates and
# repairs, it never removes what the old declaration had). Invalid or unreadable = refused, the
# running fabric is kept and the reason shows up in `cfab status`.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# 3 = the declaration or this host refused the apply; 4 = another supervisor holds the lock.
# Neither is fixed by trying again.
RestartPreventExitStatus=3 4
# 6 = "the declaration changed, start me again on it". Both lines are needed: SuccessExitStatus
# keeps the unit out of `failed` (the stop was clean and deliberate), and RestartForceExitStatus
# then restarts it anyway, which Restart=on-failure alone would not do for a success status.
SuccessExitStatus=6
RestartForceExitStatus=6
# The apply may take START_WAIT (30 s) + SETTLE (3 s) before READY=1.
TimeoutStartSec=120
# The stop sequence signals all children at once and gives each 10 s before SIGKILL, then
# tears the fabric down.
TimeoutStopSec=60
WatchdogSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
