# {{ ansible_managed }}
[Unit]
Description=cluster-network-fabric member ({{ cfab_host }}): cfab run (apply + supervise)
# The wires must be named and up (udev .link files, ifupdown2) before bringup.
After=network-online.target networking.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
Environment=CFAB_HOST={{ cfab_host }}
ExecStart=/usr/bin/cfab -c {{ cfab_conf_path }} run
# reload = SIGHUP to the supervisor: re-apply in place, no netdev churn; the engine and
# shape-daemon children restart. `cfab up` is retired — there is no longer a separate bringup verb.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=3 4
KillMode=mixed
KillSignal=SIGTERM
# SIGTERM makes `cfab run` tear itself down and exit 0; there is no separate ExecStop.

[Install]
WantedBy=multi-user.target
